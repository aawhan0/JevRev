{
  "description": "Schema for reproducible JevRev benchmark results.",
  "required": ["strategy", "dataset", "accuracy", "mean_latency_ms", "total_cost_usd"],
  "properties": {
    "strategy": {"type": "string"},
    "dataset": {"type": "string"},
    "accuracy": {"type": "number"},
    "mean_latency_ms": {"type": "number"},
    "total_cost_usd": {"type": "number"},
    "large_calls": {"type": "integer"},
    "total_calls": {"type": "integer"}
  }
}
